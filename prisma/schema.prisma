// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

//ENUMS

enum UserRole {
  CLIENT
  WAITER
  COOK
  BRANCH_ADMIN //Es según la sucursal
  GENERAL_MANAGER
  CASHIER
  INVENTORY_MANAGER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
  NEEDS_CLEANING

  @@map("table_status")
}

enum DishStatus {
  AVAILABLE
  SOLD_OUT
  DISABLED

  @@map("dish_status")
}

enum AccountStatus {
  OPEN
  CLOSED
  CANCELED

  @@map("account_status")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  READY
  DELIVERED
  CANCELED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  OTHER

  @@map("payment_method")
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY

  @@map("order_type")
}

enum OrderItemStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELED

  @@map("order_item_status")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW

  @@map("reservation_status")
}

enum InventoryMovementType {
  PURCHASE
  CONSUMPTION
  STOCK_IN
  STOCK_OUT

  @@map("inventory_movement_type")
}

enum RedemptionStatus {
  PENDING
  USED
  CANCELED
  EXPIRED

  @@map("redemption_status")
}

enum PointsMovementType {
  EARN
  REDEEM
  ADJUSTMENT

  @@map("points_movement_type")
}

enum FiscalDocumentType {
  INVOICE
  TAX_CREDIT
  RECEIPT
  OTHER

  @@map("fiscal_document_type")
}

//MODELS

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  address   String   @db.VarChar(250)
  timeZone  String   @default("America/El_Salvador") @map("time_zone") @db.VarChar(60)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users        User[]
  tables       DiningTable[]
  accounts     Account[]
  orders       Order[]
  reservations Reservation[]
  branchesIngredients BranchIngredient[]
  purchases    Purchase[]
  payments     Payment[]
  reviews      Review[]

  @@map("branches")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  lastName     String?  @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true) @map("is_active")

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  customerAccounts   Account[]            @relation("AccountCustomer")
  customerOrders     Order[]              @relation("OrderCustomer")
  waiterOrders       Order[]              @relation("OrderWaiter")
  reservations       Reservation[]
  inventoryMovements InventoryMovement[]
  redemptions        Redemption[]
  pointsMovements    PointsMovement[]
  reviews            Review[]
  notifications      Notification[]
  orderStatusChanges OrderStatusHistory[]

  @@index([branchId])
  @@index([role, isActive])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model DiningTable {
  id       String      @id @default(uuid()) @db.Uuid
  branchId String      @map("branch_id") @db.Uuid
  number   String      @db.VarChar(20)
  capacity Int
  status   TableStatus @default(AVAILABLE)

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  accounts     Account[]
  reservations Reservation[]

  @@unique([branchId, number])
  @@index([branchId, status])
  @@map("tables")
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String?
  isActive    Boolean @default(true) @map("is_active")

  dishes Dish[]

  @@map("categories")
}

model Dish {
  id          String     @id @default(uuid()) @db.Uuid
  categoryId  String     @map("category_id") @db.Uuid
  name        String     @db.VarChar(150)
  description String?
  price       Decimal    @db.Decimal(12, 2)
  imageUrl    String?    @map("image_url")
  status      DishStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  recipes    Recipe[]

  @@map("dishes")
}

model Account {
  id         String        @id @default(uuid()) @db.Uuid
  branchId   String        @map("branch_id") @db.Uuid
  tableId    String?       @map("table_id") @db.Uuid
  customerId String?       @map("customer_id") @db.Uuid
  status     AccountStatus @default(OPEN)
  openedAt   DateTime      @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt   DateTime?     @map("closed_at") @db.Timestamptz(6)

  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table    DiningTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customer User?        @relation("AccountCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  orders   Order[]
  payment  Payment?

  @@index([branchId, status])
  @@index([tableId, status])
  @@index([customerId])
  @@map("accounts")
}

model Order {
  id                   String    @id @default(uuid()) @db.Uuid
  branchId             String    @map("branch_id") @db.Uuid
  accountId            String?   @map("account_id") @db.Uuid
  customerId           String?   @map("customer_id") @db.Uuid
  waiterId             String?   @map("waiter_id") @db.Uuid
  orderNumber          String?   @map("order_number") @db.VarChar(30)
  type                 OrderType
  recipientName        String?   @map("recipient_name")
  recipientPhone       String?   @map("recipient_phone")
  deliveryAddress      String?   @map("delivery_address")
  deliveryReference    String?   @map("delivery_reference")
  deliveryInstructions String?   @map("delivery_instructions")

  status           OrderStatus   @default(PENDING)
  operationId      String        @unique @default(uuid()) @map("operation_id") @db.Uuid
  pickupAt         DateTime?     @map("pickup_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  account  Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer User?    @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  waiter   User?    @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)

  items          OrderItem[]
  payment        Payment?
  inventoryMoves InventoryMovement[]
  statusHistory  OrderStatusHistory[]
  review         Review?

  @@unique([branchId, orderNumber])
  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([accountId])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @map("order_id") @db.Uuid
  dishId    String          @map("dish_id") @db.Uuid
  dishName  String          @map("dish_name") @db.VarChar(150)
  quantity  Int
  unitPrice Decimal         @map("unit_price") @db.Decimal(12, 2)
  note      String?
  status    OrderItemStatus @default(PENDING)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish  @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([dishId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")
  note           String?
  changedAt      DateTime     @default(now()) @map("changed_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, changedAt])
  @@map("order_status_history")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  branchId    String            @map("branch_id") @db.Uuid
  tableId     String            @map("table_id") @db.Uuid
  customerId  String?           @map("customer_id") @db.Uuid
  contactName String            @map("contact_name") @db.VarChar(120)
  phone       String            @db.VarChar(30)
  guests      Int
  startsAt    DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime          @map("ends_at") @db.Timestamptz(6)
  status      ReservationStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table    DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customer User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tableId, startsAt])
  @@index([branchId, startsAt])
  @@index([customerId, startsAt])
  @@map("reservations")
}

model Ingredient {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(150)
  unit         String  @db.VarChar(30)
  isActive     Boolean @default(true) @map("is_active")

  recipes       Recipe[]
  branches BranchIngredient[]

  @@map("ingredients")
}

model BranchIngredient {
  id           String  @id @default(uuid()) @db.Uuid
  branchId     String  @map("branch_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  currentStock Decimal @default(0) @map("current_stock") @db.Decimal(14, 3)
  minimumStock Decimal @default(0) @map("minimum_stock") @db.Decimal(14, 3)
  isActive Boolean @default(true) @map("is_active")

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  purchaseItems PurchaseDetail[]
  movements     InventoryMovement[]

  @@unique([branchId, ingredientId])
  @@index([branchId, currentStock])
  @@map("branch_ingredients")
}

model Recipe {
  dishId       String  @map("dish_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(14, 3)

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([dishId, ingredientId])
  @@index([ingredientId])
  @@map("recipes")
}

model Purchase {
  id            String   @id @default(uuid()) @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  supplier      String   @db.VarChar(180)
  purchasedAt   DateTime @default(now()) @map("purchased_at") @db.Timestamptz(6)
  invoiceNumber String?  @map("invoice_number") @db.VarChar(80)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  details   PurchaseDetail[]
  movements InventoryMovement[]

  @@unique([branchId, invoiceNumber])
  @@index([branchId, purchasedAt])
  @@map("purchases")
}

model PurchaseDetail {
  id             String    @id @default(uuid()) @db.Uuid
  purchaseId     String    @map("purchase_id") @db.Uuid
  branchIngredientId   String    @map("branch_ingredient_id") @db.Uuid
  quantity       Decimal   @db.Decimal(14, 3)
  unitCost       Decimal   @map("unit_cost") @db.Decimal(12, 4)
  expirationDate DateTime? @map("expiration_date") @db.Date

  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  branchIngredient BranchIngredient @relation(fields: [branchIngredientId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([branchIngredientId])
  @@map("purchase_details")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  branchIngredientId   String                @map("branch_ingredient_id") @db.Uuid
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(14, 3)
  previousStock  Decimal               @map("previous_stock") @db.Decimal(14, 3)
  resultingStock Decimal               @map("resulting_stock") @db.Decimal(14, 3)
  purchaseId     String?               @map("purchase_id") @db.Uuid
  orderId        String?               @map("order_id") @db.Uuid
  userId         String?               @map("user_id") @db.Uuid
  note           String?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  branchIngredient BranchIngredient @relation(fields: [branchIngredientId], references: [id], onDelete: Restrict)
  purchase   Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([branchIngredientId, createdAt])
  @@index([orderId])
  @@index([purchaseId])
  @@map("inventory_movements")
}

model FiscalClient {
  id           String   @id @default(uuid()) @db.Uuid
  taxpayerName String   @map("taxpayer_name") @db.VarChar(180)
  duiNit       String   @unique @map("dui_nit") @db.VarChar(30)
  nrc          String?  @db.VarChar(30)
  address      String?  @db.VarChar(250)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payments        Payment[]
  fiscalDocuments FiscalDocument[]

  @@map("fiscal_clients")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  accountId      String?       @unique @map("account_id") @db.Uuid
  orderId        String?       @unique @map("order_id") @db.Uuid
  fiscalClientId String?       @map("fiscal_client_id") @db.Uuid
  subtotal       Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  tip            Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  totalPaid      Decimal       @map("total_paid") @db.Decimal(12, 2)
  receiptNumber  String?       @unique @map("receipt_number") @db.VarChar(80)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fiscalClient    FiscalClient?    @relation(fields: [fiscalClientId], references: [id], onDelete: SetNull)
  details         PaymentDetail[]
  fiscalDocument  FiscalDocument?
  pointsMovements PointsMovement[]

  @@index([branchId, createdAt])
  @@index([fiscalClientId])
  @@map("payments")
}

model PaymentDetail {
  id        String        @id @default(uuid()) @db.Uuid
  paymentId String        @map("payment_id") @db.Uuid
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?       @db.VarChar(150)
  cashTendered      Decimal?      @map("cash_tendered") @db.Decimal(12, 2)
  changeAmount      Decimal?      @map("change_amount") @db.Decimal(12, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_details")
}

model FiscalDocument {
  id             String             @id @default(uuid()) @db.Uuid
  paymentId      String             @unique @map("payment_id") @db.Uuid
  documentType   FiscalDocumentType @map("document_type")
  documentNumber String             @unique @map("document_number") @db.VarChar(100)
  fiscalClientId String?            @map("fiscal_client_id") @db.Uuid
  issuedAt       DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuerData     Json?              @map("issuer_data")
  receiverData   Json?              @map("receiver_data")

  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  fiscalClient FiscalClient? @relation(fields: [fiscalClientId], references: [id], onDelete: SetNull)

  @@map("fiscal_documents")
}

model PointsRule {
  id              String    @id @default(uuid()) @db.Uuid
  pointsPerDollar Decimal   @map("points_per_dollar") @db.Decimal(10, 2)
  isActive        Boolean   @default(true) @map("is_active")
  startsAt        DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)

  movements PointsMovement[]

  @@index([isActive, startsAt, endsAt])
  @@map("points_rules")
}

model Benefit {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(120)
  description String?
  pointsCost  Int     @map("points_cost")
  discount    Decimal @default(0) @db.Decimal(12, 2)
  isActive    Boolean @default(true) @map("is_active")

  redemptions Redemption[]

  @@index([isActive])
  @@map("benefits")
}

model Redemption {
  id         String           @id @default(uuid()) @db.Uuid
  customerId String           @map("customer_id") @db.Uuid
  benefitId  String           @map("benefit_id") @db.Uuid
  code       String           @unique @db.VarChar(80)
  pointsCost Int              @map("points_cost")
  status     RedemptionStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt     DateTime?        @map("used_at") @db.Timestamptz(6)

  customer       User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  benefit        Benefit         @relation(fields: [benefitId], references: [id], onDelete: Restrict)
  pointsMovement PointsMovement?

  @@index([customerId, createdAt])
  @@map("redemptions")
}

model PointsMovement {
  id           String             @id @default(uuid()) @db.Uuid
  customerId   String             @map("customer_id") @db.Uuid
  pointsRuleId String?            @map("points_rule_id") @db.Uuid
  type         PointsMovementType
  points       Int
  paymentId    String?            @map("payment_id") @db.Uuid
  redemptionId String?            @unique @map("redemption_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  customer   User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pointsRule PointsRule? @relation(fields: [pointsRuleId], references: [id], onDelete: SetNull)
  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  redemption Redemption? @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("points_movements")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @map("order_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer User   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
  @@map("reviews")
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  type          String   @db.VarChar(40)
  title         String   @db.VarChar(160)
  message       String
  referenceType String?  @map("reference_type") @db.VarChar(40)
  referenceId   String?  @map("reference_id") @db.Uuid
  eventKey      String?  @map("event_key") @db.VarChar(100)
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([referenceType, referenceId])
  @@map("notifications")
}
