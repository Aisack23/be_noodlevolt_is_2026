// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

//ENUMS

enum UserRole{
  CLIENT
  WAITER
  COOK
  BRANCH_ADMIN //Es según la sucursal
  GENERAL_MANAGER
  CASHIER
}

enum TableStatus{
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
  @@map("table_status")
}

enum DishStatus {
  AVAILABLE
  SOLD_OUT
  DISABLED
  @@map("dish_status")
} 

enum AccountStatus{
  OPEN
  CLOSED
  CANCELED
  @@map("account_status")
}

enum OrderStatus{
  PENDING
  CONFIRMED
  IN_PREPARATION
  READY
  DELIVERED
  CANCELED
  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
  REFUNDED
  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  OTHER
  @@map("payment_method")
}

enum OrderItemStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELED
  @@map("order_item_status")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
  @@map("reservation_status")
}

enum InventoryMovementType {
  PURCHASE
  CONSUMPTION
  STOCK_IN
  STOCK_OUT
  @@map("inventory_movement_type")
}

enum RedemptionStatus {
  PENDING
  USED
  CANCELED
  EXPIRED
  @@map("redemption_status")
}

enum PointsMovementType {
  EARN
  REDEEM
  ADJUSTMENT
  @@map("points_movement_type")
}

enum FiscalDocumentType {
  INVOICE
  TAX_CREDIT
  RECEIPT
  OTHER
  @@map("fiscal_document_type")
}

//MODELS
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(CLIENT)   
  isActive     Boolean  @default(true) @map("is_active")

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
