# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL (consumido por docker-compose para inicializar el contenedor)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=si_be_boilerplate
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Prisma
# Al correr la API en el host contra el Postgres de Docker, el host es localhost.
# Al correr la API dentro de docker-compose, docker-compose.yml sobreescribe
# esta variable para apuntar al servicio `postgres` en lugar de `localhost`.
# ---------------------------------------------------------------------------
DATABASE_URL=
CONTAINER_DATABASE_URL=

# ---------------------------------------------------------------------------
# Autenticación
# Generá un secreto propio: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

CORS_ORIGINS=
TRUSTED_PROXY_CIDRS=
IP_ALLOWLIST=
SWAGGER_ENABLED=false
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_LOGIN_IP=10
RATE_LIMIT_LOGIN_ACCOUNT=30
RATE_LIMIT_REGISTER=10
RATE_LIMIT_REFRESH=30
RATE_LIMIT_WRITES=60

# Contraseña de los usuarios demo del seed (mínimo 12, máximo 72 bytes).
DEMO_SEED_PASSWORD=
# Solo true al correr el seed contra producción una vez; sin esto el seed se niega.
ALLOW_DEMO_SEED=false
